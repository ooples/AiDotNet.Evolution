<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The surrogate package is experimental (AIDEVO001); this smoke test is a deliberate consumer. -->
    <NoWarn>$(NoWarn);AIDEVO001</NoWarn>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AiDotNet.Evolution" Version="[$(CorePackageVersion)]" />
    <PackageReference Include="AiDotNet.Evolution.Surrogates" Version="[$(SurrogatePackageVersion)]" />
  </ItemGroup>
</Project>
