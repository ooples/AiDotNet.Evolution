<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>aidotnet-evolve</AssemblyName>
    <RootNamespace>AiDotNet.Evolution.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aidotnet-evolve</ToolCommandName>
    <PackageId>AiDotNet.Evolution.Cli</PackageId>
    <Description>Run and resume AiDotNet.Evolution program evolutions; inspect, compare, export and report runs from their trace files.</Description>
    <IsPackable>true</IsPackable>
    <Version>0.1.0-preview.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AiDotNet.Evolution.Tests" />
    <ProjectReference Include="../AiDotNet.Evolution/AiDotNet.Evolution.csproj" />
    <ProjectReference Include="../AiDotNet.Evolution.Programs/AiDotNet.Evolution.Programs.csproj" />
  </ItemGroup>
</Project>