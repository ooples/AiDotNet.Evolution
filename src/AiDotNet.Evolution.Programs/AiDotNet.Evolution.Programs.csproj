<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The experience memory is experimental (AIDEVO004); this assembly uses it deliberately. -->
    <NoWarn>$(NoWarn);AIDEVO004</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.2.0</Version>
    <Description>Compiler-neutral bounded program improvement and artifact-bound promotion.</Description>
    <RepositoryUrl>https://github.com/ooples/AiDotNet.Evolution</RepositoryUrl>
    <PackageLicenseFile>AIDOTNET-LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="AIDOTNET-LICENSE.txt" Pack="true" PackagePath="AIDOTNET-LICENSE.txt"/>
    <None Include="../../LICENSE" Pack="true" PackagePath="APACHE-LICENSE.txt"/>
    <InternalsVisibleTo Include="AiDotNet.Evolution.CSharp.Tests"/>
    <InternalsVisibleTo Include="AiDotNet.Evolution.CSharp"/>
    <InternalsVisibleTo Include="AiDotNet.Evolution.Deployment"/>
    <None Include="../../docs/COMPILER_GUIDED_PROGRAMS.md" Pack="true" PackagePath="README.md"/>
    <ProjectReference Include="../AiDotNet.Evolution/AiDotNet.Evolution.csproj"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
  </ItemGroup>
  <!--
    The embedded build is always the guardian's net8.0 one, built here on demand: the reference alone would build the
    framework matching each Programs target, and a clean net10.0 build would then embed a file that does not exist yet.

    The Linux sandbox guardian (SandboxGuardian) is embedded rather than packaged: every dll under lib/ would become a
    compile reference for consumers. The project reference only orders the build; the target embeds its output.
  -->
  <ItemGroup>
    <ProjectReference Include="../AiDotNet.Evolution.Sandbox.Guardian/AiDotNet.Evolution.Sandbox.Guardian.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SetTargetFramework="TargetFramework=net8.0"/>
  </ItemGroup>
  <Target Name="EmbedSandboxGuardian" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../AiDotNet.Evolution.Sandbox.Guardian/AiDotNet.Evolution.Sandbox.Guardian.csproj"
             Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net8.0">
      <Output TaskParameter="TargetOutputs" ItemName="_SandboxGuardianAssembly"/>
    </MSBuild>
    <ItemGroup>
      <EmbeddedResource Include="@(_SandboxGuardianAssembly)"
                        LogicalName="AiDotNet.Evolution.Programs.Execution.SandboxGuardian.dll"/>
      <EmbeddedResource Include="@(_SandboxGuardianAssembly->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')"
                        LogicalName="AiDotNet.Evolution.Programs.Execution.SandboxGuardian.runtimeconfig.json"/>
    </ItemGroup>
  </Target>
  <!-- V1-11: the public API is declared (PublicAPI.*.txt) and every change to it must be too. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all"/>
    <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
    <AdditionalFiles Include="PublicAPI.Unshipped.txt"/>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Execution\warm_python_worker.py" LogicalName="AiDotNet.Evolution.Programs.Execution.warm_python_worker.py" />
  </ItemGroup>
</Project>
