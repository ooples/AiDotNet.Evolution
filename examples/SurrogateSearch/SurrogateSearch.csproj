<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Demonstrates an experimental research surface; consumers opt in the same way. -->
    <NoWarn>$(NoWarn);AIDEVO001;AIDEVO002;AIDEVO003</NoWarn>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AiDotNet.Evolution.Surrogates/AiDotNet.Evolution.Surrogates.csproj" />
    <ProjectReference Include="../../src/AiDotNet.Evolution/AiDotNet.Evolution.csproj" />
  </ItemGroup>
</Project>
